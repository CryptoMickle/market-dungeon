{
  "name": "market-dungeon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:shannon": "node --test tests/shannon-spike/proof-kernel.test.mjs",
    "test:e2e": "playwright test",
    "test:smoke:live": "playwright test --config=playwright.live.config.ts",
    "pilot:summarize": "node --experimental-strip-types scripts/summarize-pilot.ts",
    "release:verify": "npm run lint && npm run typecheck && npm test && npm run test:shannon && npm run build -- --webpack && npm run test:e2e"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "0.29.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
