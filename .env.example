# Generate a unique 32-byte secret and encode it as exactly 64 hexadecimal characters.
# Configure different values for Preview and Production. Never commit a real key.
JUDGE_REPLAY_SEAL_KEY=replace-with-exactly-64-hex-characters

# Optional local Kevin rival prototype. Ignored on Vercel; off unless explicitly set.
# Simulation needs no wallet. A real request uses a browser wallet on Shannon testnet.
MARKET_DUNGEON_LOCAL_AGENTS=0

# Hosted editions opt in separately. Keep the Production seal key independent
# of Preview/local keys; no wallet private key or server-funded account is used.
MARKET_DUNGEON_PREVIEW_AGENTS=0
MARKET_DUNGEON_PRODUCTION_AGENTS=0
